# Copie para ".env" e preencha com seus valores reais. Nunca commite o .env de verdade.

# --- OCI ---
OCI_CONFIG_FILE=/home/opc/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=ocid1.tenancy.oc1..xxxxxxxx

# Pegue os valores exatos clicando em "View code" no playground do Generative AI (Chat/Embedding)
